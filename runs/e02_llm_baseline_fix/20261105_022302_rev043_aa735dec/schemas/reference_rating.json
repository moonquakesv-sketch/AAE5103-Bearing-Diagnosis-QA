{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "points",
    "claims",
    "voluntary_citations",
    "complete_claim_inventory",
    "complete_citation_inventory"
  ],
  "properties": {
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "point_id",
          "score",
          "quotes",
          "reason"
        ],
        "properties": {
          "point_id": {
            "type": "string"
          },
          "score": {
            "enum": [
              0,
              0.5,
              1,
              null
            ]
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "text"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "quote",
          "support",
          "reason"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "quote": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "text"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          },
          "support": {
            "enum": [
              "full",
              "partial",
              "none",
              "outside_reference",
              "machine_unresolved"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "voluntary_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "citation_id",
          "quote",
          "status",
          "reason"
        ],
        "properties": {
          "citation_id": {
            "type": "string"
          },
          "quote": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "text"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            }
          },
          "status": {
            "enum": [
              "supported",
              "contradicted",
              "fabricated_id",
              "unverifiable",
              "machine_unresolved"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "complete_claim_inventory": {
      "const": true
    },
    "complete_citation_inventory": {
      "const": true
    }
  }
}
